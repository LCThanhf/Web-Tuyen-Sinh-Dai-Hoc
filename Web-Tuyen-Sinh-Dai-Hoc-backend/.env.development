# Development Environment Configuration
# 
# This file contains development environment variables.
# These settings are optimized for local development.

# Database Configuration
# Using SQLite for development (simple and portable)
DATABASE_URL="file:./dev.db"

# JWT Security
# Development JWT secret (not secure for production)
JWT_SECRET="dev-jwt-secret-key-not-for-production-use"

# Server Configuration
PORT=5001
NODE_ENV=development

# Frontend URL for CORS (development)
FRONTEND_URL="http://localhost:5173"

# Development settings
DB_POOL_MIN=1
DB_POOL_MAX=5

# Relaxed rate limiting for development
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=1000

# File upload settings
MAX_FILE_SIZE=10485760
UPLOAD_DIR="./uploads"

# Logging (verbose for development)
LOG_LEVEL=debug
LOG_FILE=./logs/dev.log

# Enable detailed error messages in development
ENABLE_ERROR_STACK=true
