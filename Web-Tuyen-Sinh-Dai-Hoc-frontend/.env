# Development Environment Configuration for Frontend
#
# This file contains development environment variables for the React frontend.
# All variables must be prefixed with VITE_ to be accessible in the build.

# Backend API Configuration (development)
VITE_API_BASE_URL=http://localhost:5001/api

# Application Configuration
VITE_APP_NAME="Hệ thống Tuyển sinh Đại học (Dev)"
VITE_APP_VERSION=1.0.0-dev

# Environment identifier
VITE_NODE_ENV=development

# Feature flags for development
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=true

# File upload settings (should match backend)
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png

# UI Configuration
VITE_DEFAULT_LANGUAGE=vi
VITE_DEFAULT_THEME=light

# Development-specific settings
VITE_ENABLE_DEV_TOOLS=true
VITE_SHOW_DEBUG_INFO=true
