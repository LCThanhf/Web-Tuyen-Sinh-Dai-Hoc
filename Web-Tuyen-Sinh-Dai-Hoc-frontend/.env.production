# Production Environment Configuration for Frontend
#
# IMPORTANT: This file contains production environment variables for the React frontend.
# All variables must be prefixed with VITE_ to be accessible in the build.
# 
# Instructions:
# 1. Update VITE_API_BASE_URL with your production backend URL
# 2. Configure any other production-specific settings
# 3. Run 'npm run build' to create production build with these variables

# Backend API Configuration
# Update this with your production backend URL
VITE_API_BASE_URL=https://api.yourdomain.com/api

# Application Configuration
VITE_APP_NAME="Hệ thống Tuyển sinh Đại học"
VITE_APP_VERSION=1.0.0

# Environment identifier
VITE_NODE_ENV=production

# Feature flags (if needed)
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false

# Third-party services (if applicable)
# VITE_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
# VITE_SENTRY_DSN=https://your-sentry-dsn

# File upload settings (should match backend)
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png

# UI Configuration
VITE_DEFAULT_LANGUAGE=vi
VITE_DEFAULT_THEME=light
